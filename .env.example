# Ova aplikacija koristi session pooler URL za Prisma runtime.
# Isti kljuc mora postojati i u Vercel Environment Variables.
TERMIN_POSTGRES_URL_NON_POOLING="postgres://postgres.PROJEKAT:LOZINKA@REGION.pooler.supabase.com:5432/postgres?sslmode=require"
TERMIN_POSTGRES_PRISMA_URL="postgres://postgres.PROJEKAT:LOZINKA@REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
TERMIN_POSTGRES_DATABASE="postgres"
TERMIN_POSTGRES_USER="postgres"

TERMIN_SUPABASE_URL="https://PROJEKAT.supabase.co"
TERMIN_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
NEXT_PUBLIC_TERMIN_SUPABASE_URL="https://PROJEKAT.supabase.co"
NEXT_PUBLIC_TERMIN_SUPABASE_ANON_KEY="anon-key"
NEXT_PUBLIC_SUPABASE_URL="https://PROJEKAT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

NEXTAUTH_SECRET="promeni-ovu-vrednost"
NEXTAUTH_URL="http://localhost:3000"
