generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("TERMIN_POSTGRES_PRISMA_URL")
  directUrl = env("TERMIN_POSTGRES_URL_NON_POOLING")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Season {
  id        String     @id @default(cuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean    @default(false)
  matches   Match[]
  standings Standing[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Team {
  id           String     @id @default(cuid())
  name         String
  shortName    String     @unique
  city         String
  foundedYear  Int
  primaryColor String
  logoUrl      String?
  players      Player[]
  homeMatches  Match[]    @relation("HomeTeam")
  awayMatches  Match[]    @relation("AwayTeam")
  standings    Standing[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Player {
  id        String         @id @default(cuid())
  name      String
  position  String
  shirtNumber Int
  teamId    String
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  events    MatchEvent[]
  ratings   PlayerRating[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Match {
  id          String         @id @default(cuid())
  seasonId    String
  season      Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  homeTeamId  String
  awayTeamId  String
  homeTeam    Team           @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam    Team           @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  homeScore   Int?
  awayScore   Int?
  playedAt    DateTime
  venue       String
  status      MatchStatus    @default(SCHEDULED)
  events      MatchEvent[]
  ratings     PlayerRating[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model MatchEvent {
  id        String         @id @default(cuid())
  matchId   String
  match     Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type      MatchEventType
  minute    Int
  relatedPlayerId String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model PlayerRating {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rating    Decimal  @db.Decimal(3, 1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, playerId])
}

model Standing {
  id           String   @id @default(cuid())
  seasonId     String
  season       Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  played       Int      @default(0)
  won          Int      @default(0)
  drawn        Int      @default(0)
  lost         Int      @default(0)
  goalsFor     Int      @default(0)
  goalsAgainst Int      @default(0)
  points       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([seasonId, teamId])
}

enum Role {
  ADMIN
  USER
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

enum MatchEventType {
  GOAL
  ASSIST
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
}
